* text=auto eol=lf

# Source
*.rs        text diff=rust
*.toml      text
*.sql       text
*.wgsl      text
*.glsl      text
*.metal     text
*.hlsl      text

# Docs
*.md        text diff=markdown
*.txt       text
*.adoc      text
LICENSE*    text
README*     text
CHANGELOG*  text

# Data and config
*.json      text
*.jsonl     text
*.yaml      text
*.yml       text
*.csv       text
*.ini       text
*.cfg       text
*.xml       text
*.plist     text
*.desktop   text
*.service   text
*.env.example text
.editorconfig text
.gitattributes text export-ignore
.gitignore  text export-ignore
.github/**  export-ignore

# Web
*.html      text diff=html
*.css       text diff=css
*.js        text
*.ts        text

# Scripts
*.sh        text eol=lf
*.bash      text eol=lf
*.fish      text eol=lf
*.py        text diff=python
Makefile    text eol=lf
justfile    text eol=lf
Dockerfile  text eol=lf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Windows packaging
*.rc        text eol=crlf
*.wxs       text eol=crlf
*.manifest  text eol=crlf

# Generated
Cargo.lock        text linguist-generated=true -diff merge=binary
*.openflow.json   text linguist-generated=true -diff
*.svg             text linguist-generated=true -diff

# Test fixtures from harness logs
**/fixtures/**    linguist-vendored=true
**/testdata/**    linguist-vendored=true
**/fixtures/**/*.jsonl  text eol=lf -diff
**/testdata/**/*.jsonl  text eol=lf -diff

